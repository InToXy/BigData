import time
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
from pyspark.sql import SparkSession
import os

# Définir les variables d'environnement pour forcer les timeouts
os.environ['SPARK_DIST_CLASSPATH'] = '/usr/lib/hadoop/*:/usr/lib/hadoop-hdfs/*:/usr/lib/hadoop-yarn/*'

# --- Configuration Spark pour MinIO ---
# Utilise Hadoop 3.3.2 pour éviter le bug de parsing des timeouts de 3.3.4+
spark = (
    SparkSession.builder
    .appName("PerformanceGraphs")
    .config("spark.jars.packages", "org.apache.hadoop:hadoop-aws:3.3.2,com.amazonaws:aws-java-sdk-bundle:1.11.1026")
    .config("spark.hadoop.fs.s3a.impl", "org.apache.hadoop.fs.s3a.S3AFileSystem")
    .config("spark.hadoop.fs.s3a.endpoint", "http://127.0.0.1:9000")
    .config("spark.hadoop.fs.s3a.access.key", "minioadmin")
    .config("spark.hadoop.fs.s3a.secret.key", "minioadmin123")
    .config("spark.hadoop.fs.s3a.path.style.access", "true")
    .config("spark.hadoop.fs.s3a.connection.ssl.enabled", "false")
    .config("spark.hadoop.fs.s3a.connection.timeout", "200000")
    .config("spark.hadoop.fs.s3a.connection.establish.timeout", "5000")
    .config("spark.hadoop.fs.s3a.attempts.maximum", "3")
    .getOrCreate()
)

spark.sparkContext.setLogLevel("WARN")

# --- Buckets et datasets à tester ---
bucket = "bronze"
datasets = [
    "activites_professionnels",
    "adherents",
    "consultations",
    "deces"
]

# --- Mesure du temps de lecture des datasets ---
performance_data = []

for ds in datasets:
    dataset_path = f"s3a://{bucket}/{ds}"
    start_time = time.time()
    try:
        df_spark = spark.read.parquet(dataset_path)
        count = df_spark.count()
        elapsed = time.time() - start_time
        print(f"✅ Dataset '{ds}' lu ({count} lignes) en {elapsed:.2f}s")
        performance_data.append({"dataset": ds, "rows": count, "time": elapsed})
    except Exception as e:
        print(f"❌ Erreur sur '{ds}': {e}")
        performance_data.append({"dataset": ds, "rows": 0, "time": None})

# --- Conversion en DataFrame pandas pour seaborn ---
performance_df = pd.DataFrame(performance_data)

# --- Graphiques de performance ---
sns.set(style="whitegrid")

# Temps de lecture
plt.figure(figsize=(10, 6))
sns.barplot(x="dataset", y="time", data=performance_df, hue="dataset", palette="viridis", legend=False)
plt.title("Temps de lecture des datasets (s)")
plt.ylabel("Temps (s)")
plt.xlabel("Dataset")
plt.xticks(rotation=45, ha='right')
plt.tight_layout()
plt.savefig("temps_lecture.png")
print("✅ Graphique 'temps_lecture.png' sauvegardé")

# Nombre de lignes
plt.figure(figsize=(10, 6))
sns.barplot(x="dataset", y="rows", data=performance_df, hue="dataset", palette="magma", legend=False)
plt.title("Nombre de lignes par dataset")
plt.ylabel("Nombre de lignes")
plt.xlabel("Dataset")
plt.xticks(rotation=45, ha='right')
plt.tight_layout()
plt.savefig("nombre_lignes.png")
print("✅ Graphique 'nombre_lignes.png' sauvegardé")

# --- Fin ---
spark.stop()
