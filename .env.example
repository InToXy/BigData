# ============================================================
# MINIO CONFIGURATION
# ============================================================
MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=your_minio_password
MINIO_ENDPOINT=http://minio:9000
MINIO_ENDPOINT_EXTERNAL=http://localhost:9000

# ============================================================
# POSTGRESQL - Data Source
# ============================================================
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=healthcare_data
POSTGRES_HOST=bigdata_postgres
POSTGRES_PORT=5432

# ============================================================
# MARIADB - Metastore Database
# ============================================================
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=metastore_db
MYSQL_HOST=mariadb
MYSQL_PORT=3306

# ============================================================
# HIVE METASTORE
# ============================================================
METASTORE_DB_HOSTNAME=mariadb
METASTORE_THRIFT_URI=thrift://hive-metastore:9083
METASTORE_THRIFT_PORT=9083

# ============================================================
# AIRFLOW (commented as currently disabled in docker-compose)
# ============================================================
# AIRFLOW_USER=airflow
# AIRFLOW_PASSWORD=airflow123
# AIRFLOW_DB=airflow
# AIRFLOW_FERNET_KEY=your_fernet_key

# ============================================================
# SUPERSET
# ============================================================
SUPERSET_USER=superset
SUPERSET_PASSWORD=your_superset_password
SUPERSET_DB=superset
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=your_admin_password
SUPERSET_ADMIN_EMAIL=admin@chu.com

# ============================================================
# JUPYTER
# ============================================================
JUPYTER_TOKEN=your_jupyter_token

# ============================================================
# TRINO
# ============================================================
TRINO_ENVIRONMENT=production
TRINO_PORT=8080
